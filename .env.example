# =============================================================================
# Runtime env for local / Cloud Run — copy to .env and fill in (do NOT commit .env)
#
#   copy .env.example .env
#   # edit .env
# =============================================================================

# --- GCP identity & location ---
GCP_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GCP_REGION=us-central1
# Optional zonal hint (not all clients use this)
# GCP_ZONE=us-central1-a

# --- Storage (Terraform creates: ${GCP_PROJECT}-rag-documents) ---
DOCUMENTS_BUCKET=your-gcp-project-id-rag-documents
PROCESSED_BUCKET=your-gcp-project-id-rag-processed

# --- Vertex AI Vector Search (after terraform apply / index deploy) ---
VECTOR_INDEX_ID=
VECTOR_ENDPOINT_ID=

# --- Embeddings & generation ---
EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMS=768
LLM_MODEL=gemini-2.0-flash-001
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# --- Retrieval ---
TOP_K_ANN=50
TOP_K_PROMPT=8
HYBRID_ALPHA=0.6

# --- Semantic cache (Memorystore Redis; leave localhost for preview) ---
CACHE_ENABLED=true
CACHE_SIM_THRESHOLD=0.92
CACHE_TTL=86400
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_AUTH=

# --- Chunking ---
CHUNK_STRATEGY=semantic
CHUNK_SIZE=256
CHUNK_OVERLAP=32
